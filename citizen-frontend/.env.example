# Browser-side API base. Leave EMPTY (the default) so the app calls same-origin
# relative paths (/api/*, /uploads/*, /health) and next.config.mjs proxies them to
# the backend. Only set this to an absolute URL if you intentionally want the
# browser to call the backend directly (cross-origin), in which case the backend
# CLIENT_URL must list this frontend's origin.
NEXT_PUBLIC_API_URL=

# Server-side proxy target used by next.config.mjs rewrites. The browser never
# sees this address. Defaults to http://localhost:5000 when unset.
BACKEND_URL=http://localhost:5000

# Dev-only: extra origins allowed to load Next.js /_next/* dev resources when the
# app is served behind a dev preview proxy on another host (comma-separated
# hostnames). Ignored by `next build` / `next start`. Leave empty for normal use.
ALLOWED_DEV_ORIGINS=

NEXT_PUBLIC_CITIZEN_APP_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOVERNMENT_APP_URL=http://localhost:3001
# Optional: display a public support email in the landing page footer.
NEXT_PUBLIC_SUPPORT_EMAIL=
